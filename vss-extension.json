{
  "manifestVersion": 1,
  "id": "jessehouwing-vsts-variable-tasks",
  "name": "Variable Toolbox",
  "version": "3.0.0",
  "publisher": "jessehouwing",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scope": [
    "vso.build"
  ],
  "description": "Azure Pipelines tasks for setting and expanding variables.",
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "Extension",
    "Release",
    "Build",
    "Variable",
    "Expand",
    "Override",
    "xebia"
  ],
  "screenshots": [
    {
      "path": "extension/Images/Screenshots/in-workflow.png"
    },
    {
      "path": "extension/Images/Screenshots/setvariable.png"
    },
    {
      "path": "extension/Images/Screenshots/expandvariables.png"

    }
  ],
  "content": {
    "details": {
      "path": "readme.md"
    },
    "license": {
      "path": "LICENSE.md"
    },
    "privacy": {
      "path": "PRIVACY.md"
    }
  },
  "links": {
    "getstarted": {
      "uri": "https://github.com/jessehouwing/azure-pipelines-variable-tasks/wiki"
    },
    "support": {
      "uri": "https://github.com/jessehouwing/azure-pipelines-variable-tasks/issues"
    },
    "license": {
      "uri": "https://github.com/jessehouwing/azure-pipelines-variable-tasks/LICENSE.md"
    },
    "privacypolicy": {
      "uri": "https://github.com/jessehouwing/azure-pipelines-variable-tasks/blob/main/PRIVACY.md"
    }
  },
  "badges": [
    {
      "href": "https://github.com/sponsors/jessehouwing",
      "uri": "https://img.shields.io/github/sponsors/jessehouwing",
      "description": "GitHub Sponsors"
    }
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/jessehouwing/azure-pipelines-variable-tasks"
  },
  "branding": {
    "color": "rgb(36, 43, 50)",
    "theme": "dark"
  },
  "icons": {
    "default": "extension/images/extension-icon.png"
  },
  "files": [
    {
      "path": "vsts-variable-set/"
    },
    {
      "path": "vsts-variable-expand/"
    },
    {
      "path": "vsts-variable-transform/"
    }
  ],
  "contributions": [
    {
      "id": "vsts-variable-transform",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "vsts-variable-transform"
      }
    },
    {
      "id": "vsts-variable-expand",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "vsts-variable-expand"
      }
    },
    {
      "id": "vsts-variable-set",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "vsts-variable-set"
      }
    }
  ]
}
